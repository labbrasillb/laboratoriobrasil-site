---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página não encontrada"
  description="A página que você tentou acessar não foi encontrada."
>
  <article class="article">
    <span class="eyebrow">Erro 404</span>
    <h1>Essa ideia não está por aqui.</h1>

    <p class="lead">
      A página que você tentou acessar não existe, mudou de endereço
      ou ainda não foi publicada.
    </p>

    <div class="actions">
      <a class="button primary" href="/">Voltar ao início</a>
      <a class="button" href="/artigos">Ver artigos</a>
    </div>
  </article>
</BaseLayout>

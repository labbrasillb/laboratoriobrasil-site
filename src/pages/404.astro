---
import ArticlePage from '../components/ArticlePage.astro';
import ButtonLink from '../components/ButtonLink.astro';
---

<ArticlePage
  title="Página não encontrada"
  description="A página que você tentou acessar não foi encontrada."
  eyebrow="Erro 404"
  heading="Essa ideia não está por aqui."
  lead="A página que você tentou acessar não existe, mudou de endereço ou ainda não foi publicada."
>
  <div class="actions">
    <ButtonLink href="/" variant="primary">
      Voltar ao início
    </ButtonLink>
    <ButtonLink href="/artigos">Ver artigos</ButtonLink>
  </div>
</ArticlePage>

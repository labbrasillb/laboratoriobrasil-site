---
import ArticlePage from '../../components/ArticlePage.astro';
import SocialCard from '../../components/SocialCard.astro';
import { SITE } from '../../config/site';
---

<ArticlePage
  title="Contato"
  description="Canais oficiais para conversar com o Laboratório Brasil."
  eyebrow="Contato"
  heading="Vamos conversar."
  lead="Sugestões, críticas, contrapontos e correções fazem parte do Laboratório Brasil."
>
  <div class="prose">
    <h2>Canais oficiais</h2>
    <p>Você pode acompanhar e conversar com o projeto pelos canais abaixo:</p>

    <div class="social-card-grid">
      {SITE.socials.map((social) => (
        <SocialCard {...social} />
      ))}
    </div>

    <h2>Críticas são bem-vindas</h2>
    <p>
      O Laboratório Brasil não trata propostas como verdades prontas. Se uma ideia publicada tiver
      uma falha, um efeito colateral ou uma premissa fraca, o contraponto faz parte do processo.
    </p>
    <p>Problema → hipótese → teste → crítica → revisão.</p>
  </div>
</ArticlePage>

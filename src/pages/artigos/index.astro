---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatArticleDate } from '../../lib/articles';

const artigos = (await getCollection('artigos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
---

<BaseLayout title="Artigos" description="Experimentos, propostas e análises do Laboratório Brasil.">
  <section class="section section--page-start">
    <div class="container">
      <div class="section-head">
        <div>
          <Eyebrow>Caderno do laboratório</Eyebrow>
          <h1>Artigos</h1>
        </div>
      </div>

      {artigos.length > 0 ? (
        <div class="grid">
          {artigos.map((artigo) => (
            <ArticleCard
              href={`/artigos/${artigo.id}`}
              title={artigo.data.title}
              description={artigo.data.description}
              meta={`${formatArticleDate(artigo.data.publishedAt)} · v${artigo.data.version}`}
              tags={artigo.data.tags}
            />
          ))}
        </div>
      ) : (
        <EmptyState
          title="Nenhum artigo publicado ainda."
          description="Os próximos experimentos aparecerão aqui quando estiverem prontos para discussão."
        />
      )}
    </div>
  </section>
</BaseLayout>

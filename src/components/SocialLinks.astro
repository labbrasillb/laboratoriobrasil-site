---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;

const socialLinks = [
  { name: 'YouTube', href: 'https://www.youtube.com/@labbrasillb', icon: 'youtube' },
  { name: 'Instagram', href: 'https://www.instagram.com/labbrasillb', icon: 'instagram' },
  { name: 'X', href: 'https://x.com/labbrasillb', icon: 'x' },
  { name: 'GitHub', href: 'https://github.com/labbrasillb', icon: 'github' },
];
---
<nav class:list={['social-links', className]} aria-label="Redes sociais do Laboratório Brasil">
  {socialLinks.map(({ name, href, icon }) => (
    <a class={`social-link social-link--${icon}`} href={href} target="_blank" rel="me noopener noreferrer" aria-label={`${name} do Laboratório Brasil`} title={name}>
      {icon === 'youtube' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
      )}
      {icon === 'instagram' && (
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <defs>
            <linearGradient id="instagram-gradient" x1="3" y1="21" x2="21" y2="3" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#ffdc80" />
              <stop offset="0.32" stop-color="#fcaf45" />
              <stop offset="0.56" stop-color="#f77737" />
              <stop offset="0.76" stop-color="#e1306c" />
              <stop offset="1" stop-color="#833ab4" />
            </linearGradient>
          </defs>
          <path fill="url(#instagram-gradient)" d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5Zm0 2a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3H7Zm10.5 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>
        </svg>
      )}
      {icon === 'x' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22H17l-4.9-6.4L6.5 22H3.4l7.2-8.3L.8 2H7l4.4 5.8L18.9 2Zm-1.1 17.8h1.7L6.1 4H4.3l13.5 15.8Z"/></svg>
      )}
      {icon === 'github' && (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.5-1.4-1.3-1.8-1.3-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.6.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.9-.8c1 0 2 .1 2.9.4 2.2-1.5 3.2-1.2 3.2-1.2.6 1.5.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.8 5.4-5.5 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 12 .7Z"/></svg>
      )}
    </a>
  ))}
</nav>

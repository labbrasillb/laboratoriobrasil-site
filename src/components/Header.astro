---
import { PRIMARY_NAV, SITE } from '../config/site';
import ThemeToggle from './ThemeToggle.astro';

const normalizePath = (path: string) => (path === '/' ? path : path.replace(/\/$/, ''));
const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => currentPath === normalizePath(href);
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label={`${SITE.name} — início`}>
      <img src="/assets/logo-lb.f347d33c.webp" alt="" width="44" height="44" />
      <span>{SITE.name}</span>
    </a>

    <div class="header-actions">
      <nav class="nav-links" aria-label="Navegação principal">
        {PRIMARY_NAV.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <details class="mobile-menu">
        <summary aria-label="Menu de navegação">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <span>Menu</span>
        </summary>
        <nav class="mobile-menu__panel" aria-label="Navegação móvel">
          {PRIMARY_NAV.map((item) => (
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </details>

      <ThemeToggle />
    </div>
  </div>
</header>
